# Jev 决策模型配置
#
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env  （Windows: copy .env.example .env）
#   2. 填入你的 API Key
#   3. 重启 dev server
#
# .env 已被 .gitignore 忽略，不会被提交。

# ───────────── 密钥 ─────────────
# OpenRouter 格式：sk-or-v1-...
# TypeSafe 格式：  sk_...
# 留空则只能使用 Mock 模式，或由本地代理 server/proxy.mjs 提供密钥。
JEV_API_KEY=

# ───────────── 服务地址 ─────────────
# OpenRouter Decisions API
JEV_UPSTREAM=https://openrouter.ai/api/alpha/decisions
# TypeSafe 官方（若用官方端点，把上一行改成下面这行）
# JEV_UPSTREAM=https://api.typesafe.ai/v1/systemone

# ───────────── 模型 ─────────────
# 固定版本保证行为稳定；用 jev-latest 可自动跟随最新版
JEV_DEFAULT_MODEL=typesafe/jev-1.13
# JEV_DEFAULT_MODEL=jev-latest

# ───────────── 本地代理端口 ─────────────
# npm run proxy 监听的端口
JEV_PROXY_PORT=8787
